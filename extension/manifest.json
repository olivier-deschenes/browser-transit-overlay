{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.8.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/*",
        "https://www.centris.ca/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "i18n.js",
        "networks.js",
        "settings.js",
        "sites.js",
        "labels.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sdk.locallogic.co/sdks-app/*"
      ],
      "all_frames": true,
      "css": [
        "content.css"
      ],
      "js": [
        "i18n.js",
        "networks.js",
        "settings.js",
        "sites.js",
        "labels.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sdk.locallogic.co/sdks-app/*"
      ],
      "all_frames": true,
      "js": [
        "bridge.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "networks/*.json"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://www.centris.ca/*",
        "https://sdk.locallogic.co/*"
      ]
    }
  ]
}
